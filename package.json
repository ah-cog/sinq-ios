{
  "name": "sinq-mobile",
  "version": "3.1.0",
  "private": true,
  "description": "SINQ scientific inquiry client for iOS, Android and browsers",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "prepare:ios": "cordova prepare ios",
    "build:ios": "cordova build ios --debug --emulator",
    "run:ios": "cordova run ios --emulator",
    "build:android": "cordova build android --debug",
    "run:android": "cordova run android --emulator",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "cordova": "13.0.0",
    "cordova-android": "15.1.0",
    "cordova-ios": "8.2.0"
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {}
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
